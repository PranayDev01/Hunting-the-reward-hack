        "import random\n",
        "\n",
        "class Environment:\n",
        "    def __init__(self):\n",
        "        self.goal = 10\n",
        "\n",
        "    def intended_reward(self, action):\n",
        "        # Reward for getting close to the actual goal\n",
        "        return max(0, 100 - abs(self.goal - action) * 10)\n",
        "\n",
        "    def flawed_reward(self, action):\n",
        "        # Bug: rewards large actions regardless of goal achievement\n",
        "        return action * 10\n",
        "\n",
        "\n",
        "class Agent:\n",
        "    def __init__(self):\n",
        "        self.actions = list(range(0, 21))\n",
        "\n",
        "    def choose_action(self, reward_function):\n",
        "        # Select the action with the highest observed reward\n",
        "        return max(\n",
        "            self.actions,\n",
        "            key=reward_function\n",
        "        )\n",
        "\n",
        "\n",
        "def hunt_reward_hack():\n",
        "    env = Environment()\n",
        "    agent = Agent()\n",
        "\n",
        "    print(\"=== Reward Hack Detection ===\")\n",
        "\n",
        "    # Train/evaluate using the flawed reward\n",
        "    hacked_action = agent.choose_action(env.flawed_reward)\n",
        "\n",
        "    flawed_score = env.flawed_reward(hacked_action)\n",
        "    actual_score = env.intended_reward(hacked_action)\n",
        "\n",
        "    print(\"\\nAgent behavior:\")\n",
        "    print(f\"Chosen action: {hacked_action}\")\n",
        "    print(f\"Flawed reward: {flawed_score}\")\n",
        "    print(f\"Actual goal reward: {actual_score}\")\n",
        "\n",
        "    # Basic reward-hack detector\n",
        "    reward_gap = flawed_score - actual_score\n",
        "\n",
        "    if hacked_action != env.goal:\n",
        "        print(\"\\n⚠️ Potential reward hack detected!\")\n",
        "        print(\"The agent maximized the flawed reward\")\n",
        "        print(\"instead of achieving the intended goal.\")\n",
        "    else:\n",
        "        print(\"\\nNo reward hack detected.\")\n",
        "\n",
        "    # Compare with the intended reward\n",
        "    safe_action = agent.choose_action(env.intended_reward)\n",
        "\n",
        "    print(\"\\nAfter correcting the reward function:\")\n",
        "    print(f\"Chosen action: {safe_action}\")\n",
        "    print(f\"Actual goal reward: {env.intended_reward(safe_action)}\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    hunt_reward_hack()"
